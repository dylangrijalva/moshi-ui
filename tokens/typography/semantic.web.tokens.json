    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.web.sans}",
        "fontSize": "{font.size.web.12}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.lineHeight.web.16}",
        "letterSpacing": "{font.letterSpacing.normal}"
